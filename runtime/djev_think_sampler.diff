+def _djev_post_sample_step(
+    new_tokens: torch.Tensor,  # [num_decode, CL] Gumbel-max samples
+    argmax_tokens: torch.Tensor,  # [num_decode, CL]
+    token_entropy: torch.Tensor,  # [num_decode, CL]
+    soft_flat: torch.Tensor | None,  # [num_decode * CL, hidden] probs @ E (no normalizer)
